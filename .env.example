# Postgres
POSTGRES_USER=prostor
POSTGRES_PASSWORD=prostor
POSTGRES_DB=prostor
POSTGRES_PORT=5433

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://prostor:prostor@localhost:5433/prostor

# Embeddings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

# MinIO / S3
MINIO_ROOT_USER=prostor
MINIO_ROOT_PASSWORD=prostor12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_TEMPLATES=prostor-templates
S3_BUCKET_TZ=prostor-tz

# Frontend
FRONTEND_PORT=8080

# Куда nginx во фронте проксирует /api/*. По умолчанию — сервис `backend`
# внутри compose-сети. Можно переключить на внешний бэк без пересборки.
BACKEND_URL=http://backend:8000

# DeepSeek (ключ задаётся только в игнорируемом Git файле .env.secrets)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=45
